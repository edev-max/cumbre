{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cumbre",
  "version": "0.1.0",
  "identifier": "ve.apexconsulting.cumbre",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cumbre",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Apex Consulting",
    "copyright": "© 2026 Apex Consulting",
    "category": "Business",
    "shortDescription": "Sistema administrativo para pequeños negocios",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Spanish"], "installMode": "perMachine" },
      "wix": { "language": "es-ES" }
    }
  }
}
