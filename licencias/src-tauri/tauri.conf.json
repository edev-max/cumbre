{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apex Licencias",
  "version": "1.0.0",
  "identifier": "ve.apexconsulting.licencias",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Apex Licencias", "width": 1040, "height": 760, "minWidth": 860, "minHeight": 620, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
